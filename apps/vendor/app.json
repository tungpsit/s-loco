{
  "expo": {
    "name": "S-Loco Vendor",
    "slug": "S-Loco-vendor",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "slocal-vendor",
    "platforms": ["ios", "android", "web"],
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "S-Loco Vendor cần quyền camera để quét mã QR trên voucher của khách."
        }
      ]
    ]
  }
}
