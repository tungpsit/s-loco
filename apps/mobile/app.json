{
  "expo": {
    "name": "S-Loco",
    "slug": "S-Loco-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "slocal",
    "platforms": ["ios", "android", "web"],
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "S-Loco cần truy cập camera để quét mã QR của cửa hàng."
        }
      ]
    ]
  }
}
