{
  "name": "@S-Loco/db",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "db:generate": "bun --env-file=../../.env x drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env x drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env x drizzle-kit push",
    "db:seed": "bun --env-file=../../.env run src/seed.ts",
    "db:studio": "bun --env-file=../../.env x drizzle-kit studio",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "0.45.1"
  },
  "devDependencies": {
    "@types/bun": "latest",

    "drizzle-kit": "0.31.10",
    "pg": "^8.13.0",
    "typescript": "^5.7.0"
  }
}
