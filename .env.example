# ============================================================
# S-Loco — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ─── App ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_VERSION=v1
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8081

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://sloco:sloco_dev_2026@localhost:5432/sloco
DIRECT_URL=postgres://sloco:sloco_dev_2026@localhost:5432/sloco
DB_PASSWORD=sloco_dev_2026

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT / Auth ───────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-char-secret
JWT_REFRESH_SECRET=replace-with-another-32-char-secret
JWT_ACCESS_TTL=900           # 15 minutes in seconds
JWT_REFRESH_TTL=2592000     # 30 days in seconds
QR_JWT_SECRET=replace-with-32-char-minimum-secret

# ─── Payment Gateways ─────────────────────────────────────────────────────────
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/apis
VNPAY_RETURN_URL=http://localhost:3000/api/v1/payments/vnpay/return

MOMO_PARTNER_CODE=YOUR_MOMO_PARTNER_CODE
MOMO_ACCESS_KEY=YOUR_MOMO_ACCESS_KEY
MOMO_SECRET_KEY=YOUR_MOMO_SECRET_KEY
MOMO_API_URL=https://test-payment.momo.vn
MOMO_RETURN_URL=http://localhost:3000/api/v1/payments/momo/return

SEPAY_API_KEY=YOUR_SEPAY_API_KEY
SEPAY_SECRET_KEY=YOUR_SEPAY_SECRET_KEY

# ─── iPos Reservation Discount Vouchers ──────────────────────────────────────
# Use true for local development without real iPos credentials.
IPOS_DRY_RUN=true
IPOS_BASE_URL=https://api.ipos.example
IPOS_API_KEY=YOUR_IPOS_API_KEY
IPOS_WEBHOOK_SECRET=replace-with-ipos-webhook-secret

# ─── SMS / OTP ─────────────────────────────────────────────────────────────────
# mock | esms | speedsms | infobip
SMS_PROVIDER=mock
# Comma-separated fallback chain, e.g. speedsms,infobip.
SMS_FALLBACK_PROVIDER=

ESMS_API_KEY=
ESMS_SECRET_KEY=
# Leave empty and use ESMS_SMS_TYPE=8 while testing without registered brandname.
ESMS_BRAND_NAME=
ESMS_SMS_TYPE=8
ESMS_IS_UNICODE=1

SPEEDSMS_ACCESS_TOKEN=
# Leave empty while testing without registered sender/brandname.
SPEEDSMS_SENDER=
SPEEDSMS_SMS_TYPE=2

INFOBIP_API_KEY=
INFOBIP_BASE_URL=https://api.infobip.com
# Leave empty while testing without registered sender.
INFOBIP_SENDER=

# ─── Firebase (FCM Push Notifications) ────────────────────────────────────────
# Note: Firebase Admin SDK requires Node.js runtime — configure separately.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Apple Push Notification Service (iOS Push Notifications) ────────────────
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apple-team-id
APNS_TOPIC=com.sloco.app
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── AI ────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://9router.tungps.dev/v1
OPENAI_MODEL=gpt-5.5

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
